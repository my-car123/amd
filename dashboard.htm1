<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fleet System</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- الهيدر -->
    <header class="header">
        <img src="logo.png" class="header-logo" alt="Logo">
        <div class="header-actions">
            <div id="liveClock" class="clock-widget">جاري تحميل التوقيت...</div>
            <button class="btn-lang" onclick="toggleLanguage()">English</button>
            <button class="btn-action btn-danger" onclick="window.firebaseAuth.signOut(); location.href='index.html';">خروج</button>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <div class="main-container">
        
        <!-- القائمة الجانبية -->
        <aside class="sidebar">
            <button class="sidebar-btn active" onclick="switchTab('stats')">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                <span>الإحصائيات</span>
            </button>
            <button class="sidebar-btn" onclick="switchTab('vehicles')">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                <span>المركبات</span>
            </button>
            <button class="sidebar-btn" onclick="switchTab('drivers')">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                <span>السائقين</span>
            </button>
            <button class="sidebar-btn admin-only" onclick="switchTab('users')">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <span>المستخدمين</span>
            </button>
        </aside>

        <!-- منطقة العرض -->
        <main class="content-area">
            
            <!-- لوحة الإحصائيات -->
            <section id="panel-stats" class="content-panel">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-info"><h4>إجمالي المركبات</h4><p id="statV">0</p></div>
                    </div>
                    <div class="stat-card success">
                        <div class="stat-info"><h4>إجمالي السائقين</h4><p id="statD">0</p></div>
                    </div>
                </div>
            </section>

            <!-- لوحة المركبات -->
            <section id="panel-vehicles" class="content-panel" style="display:none;">
                <div class="toolbar">
                    <input type="text" class="search-input" placeholder="بحث برقم اللوحة...">
                    <button class="btn-action btn-primary" onclick="openAddVehicleModal()">إضافة مركبة</button>
                </div>
                <div id="vehiclesList" class="data-list"></div>
            </section>

            <!-- لوحة السائقين -->
            <section id="panel-drivers" class="content-panel" style="display:none;">
                <div class="toolbar">
                    <input type="text" class="search-input" placeholder="بحث باسم السائق...">
                    <button class="btn-action btn-primary" onclick="openAddDriverModal()">إضافة سائق</button>
                </div>
                <div id="driversList" class="data-list"></div>
            </section>

            <!-- لوحة المستخدمين -->
            <section id="panel-users" class="content-panel admin-only" style="display:none;">
                <div class="toolbar">
                    <button class="btn-action btn-primary" onclick="openAddDriverModal()">إضافة مشرف</button>
                </div>
                <div id="usersList" class="data-list"></div>
            </section>

        </main>
    </div>

    <!-- نافذة منبثقة ديناميكية -->
    <div id="dynamicModal" class="modal-overlay" onclick="if(event.target === this) closeModal();">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal()">&times;</button>
            <div id="modalBody"></div>
        </div>
    </div>

    <!-- السكريبتات -->
    <script type="module" src="js/firebase-config.js"></script>
    <script src="js/logger.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
